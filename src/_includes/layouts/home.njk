---
layout: layouts/base.njk
---
<header class="page-header">
  <h1>{{ site.title }}</h1>
</header>

<div class="prose">
  {{ content | safe }}
</div>

{%- set recent = publications.items | where("category", "article") %}
{%- if recent.length %}
<h2>Recent papers</h2>
<ol class="pub-list">
  {%- for pub in recent.slice(0, 3) %}
  {% include "partials/publication.njk" %}
  {%- endfor %}
</ol>
<p><a href="/publications/">All publications →</a></p>
{%- endif %}
